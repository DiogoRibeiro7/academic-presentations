% ================================================================
% Acknowledgments Slide Template
% ================================================================

\newcommand{\acknowledgmentsslide}[1]{
\begin{frame}{Acknowledgments}
  \begin{itemize}
    #1
  \end{itemize}
  \vfill
  \centering
  {\small\textbf{Generated with \LaTeX~Beamer}}
\end{frame}
}

% ================================================================
% Convenience Slides
% ================================================================

\newcommand{\tocslide}{
\begin{frame}{Outline}
  \tableofcontents
\end{frame}
}

\AtBeginSection[]{
  \begin{frame}
  \vfill
  \centering
  \begin{beamercolorbox}[sep=8pt,center,shadow=true,rounded=true]{title}
    \usebeamerfont{title}\insertsectionhead\par%
  \end{beamercolorbox}
  \vfill
  \end{frame}
}

\endinput
