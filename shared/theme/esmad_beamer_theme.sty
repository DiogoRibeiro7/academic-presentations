% ================================================================
% Academic Beamer compatibility helpers
% Canonical presentation model: Madrid + default colour theme + red palette
% ================================================================
% Author: Diogo Ribeiro
% Institution: Faculty of Media Arts and Design, Technical University of Porto
% Version: 2.0
% Date: 2026
% ================================================================

\ProvidesPackage{esmad_beamer_theme}[2026/09/06 Canonical Academic Beamer Model]

% ================================================================
% Required Packages
% ================================================================

\RequirePackage{bookmark}
\RequirePackage[table,dvipsnames]{xcolor}
\RequirePackage{listings}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\RequirePackage{fontawesome5}
\RequirePackage{amsmath,amsthm,amssymb}
\RequirePackage{algorithm,algpseudocode}
\RequirePackage{booktabs}
\RequirePackage{colortbl}

% ================================================================
% Canonical Beamer Model
% ================================================================

\usetheme{Madrid}
\usecolortheme{default}

\setbeamercolor{palette primary}{bg=red, fg=white}
\setbeamercolor{palette secondary}{bg=red!95!black, fg=white}
\setbeamercolor{palette tertiary}{bg=red!90!black, fg=white}
\setbeamercolor{frametitle}{bg=red, fg=white}
\setbeamercolor{title}{bg=red, fg=white}
\setbeamercolor{section in toc}{fg=red}

\lstdefinestyle{code}{
  language=Python,
  basicstyle=\ttfamily\small,
  keywordstyle=\color{blue},
  commentstyle=\color{gray},
  stringstyle=\color{red!60!black},
  showstringspaces=false,
  tabsize=2,
  breaklines=true
}
\lstset{style=code}

% ================================================================
% Compatibility Colours
% ================================================================

% Keep legacy colour names available for old content, but map them onto the
% canonical red/neutral model so imported helper environments do not reintroduce
% the former blue presentation identity.
\colorlet{ESMADBlue}{red!90!black}
\colorlet{ESMADLightBlue}{red!65!black}
\colorlet{ESMADAccent}{red}
\colorlet{ESMADGray}{gray}
\colorlet{ESMADLightGray}{black!4}
\colorlet{TextDark}{black!90}
\colorlet{TextLight}{white}
\colorlet{CodeBackground}{black!3}
\colorlet{CodeComment}{gray}
\colorlet{CodeKeyword}{blue}
\colorlet{CodeString}{red!60!black}
\definecolor{forest}{RGB}{34, 139, 34}
\definecolor{navyblue}{RGB}{0, 0, 128}
\definecolor{crimson}{RGB}{220, 20, 60}
\definecolor{gold}{RGB}{255, 215, 0}

% ================================================================
% Canonical Author Information
% ================================================================

\newcommand{\authorname}[1]{\def\@authorname{#1}}
\newcommand{\authoremail}[1]{\def\@authoremail{#1}}
\newcommand{\authororcid}[1]{\def\@authororcid{#1}}

% The repository has one canonical academic affiliation. Legacy deck-level
% values are intentionally ignored so copied metadata cannot silently drift.
\newcommand{\authorinstitution}[1]{%
  \def\@authorinstitution{Faculty of Media Arts and Design, Technical University of Porto}%
}

% Former-employer metadata is deprecated. Keep the command as a no-op for
% compatibility with older decks while preventing it from being rendered.
\newcommand{\authorcompany}[1]{\def\@authorcompany{}}

\authorname{Diogo Ribeiro}
\authoremail{dfr@esmad.ipp.pt}
\authororcid{0009-0001-2022-7072}
\authorinstitution{}
\authorcompany{}

% Feed the canonical author values into standard Beamer metadata. Individual
% decks remain free to set their own title, subtitle and date.
\author{\@authorname}
\institute{\@authorinstitution}

% ================================================================
% Compatibility Listing Style
% ================================================================

% Retain the historical style name for old source files, but make it an alias
% of the canonical code model rather than a separate visual language.
\lstdefinestyle{esmadcode}{style=code}

% ================================================================
% Custom Blocks and Boxes
% ================================================================

\newenvironment{theorembox}[1]{%
  \begin{tcolorbox}[
    colback=black!3,
    colframe=red!90!black,
    fonttitle=\bfseries,
    title={#1}
  ]
}{%
  \end{tcolorbox}
}

\newenvironment{definitionbox}[1]{%
  \begin{tcolorbox}[
    colback=black!3,
    colframe=red!75!black,
    fonttitle=\bfseries,
    title={#1}
  ]
}{%
  \end{tcolorbox}
}

\newenvironment{examplebox}[1]{%
  \begin{tcolorbox}[
    colback=white,
    colframe=red!65!black,
    fonttitle=\bfseries,
    title={#1},
    boxrule=1.5pt
  ]
}{%
  \end{tcolorbox}
}

\newenvironment{alertbox}[1]{%
  \begin{tcolorbox}[
    colback=white,
    colframe=red,
    fonttitle=\bfseries,
    title={#1},
    boxrule=2pt
  ]
}{%
  \end{tcolorbox}
}

% ================================================================
% Mathematical Notation Helpers
% ================================================================

\newcommand{\Normal}{\mathcal{N}}
\newcommand{\Uniform}{\mathcal{U}}
\newcommand{\Bernoulli}{\text{Bernoulli}}
\newcommand{\Binomial}{\text{Binomial}}
\newcommand{\Poisson}{\text{Poisson}}
\newcommand{\Exponential}{\text{Exp}}
\newcommand{\Beta}{\text{Beta}}
\newcommand{\GammaDist}{\text{Gamma}}

\DeclareMathOperator{\E}{\mathbb{E}}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator{\Corr}{Corr}
\newcommand{\Prob}{\mathbb{P}}

\DeclareMathOperator{\softmax}{softmax}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

\newcommand{\vect}[1]{\boldsymbol{#1}}
\newcommand{\mat}[1]{\mathbf{#1}}
\newcommand{\indep}{\perp\!\!\!\perp}

% ================================================================
% Reference Slide Template
% ================================================================

\newcommand{\referenceslide}[1]{
\begin{frame}[allowframebreaks]{References}
  \bibliographystyle{apalike}
  \bibliography{#1}
\end{frame}
}

