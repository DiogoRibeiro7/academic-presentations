% Canonical Beamer presentation shell for this repository.
% Keep topic-specific packages and listing styles in individual presentations.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{standard_beamer_preamble}[2026/09/05 Canonical Beamer shell]

\RequirePackage{bookmark}
\RequirePackage{listings}
\RequirePackage{xcolor}

\usetheme{Madrid}
\usecolortheme{default}

\lstdefinestyle{code}{%
  language=Python,
  basicstyle=\ttfamily\small,
  keywordstyle=\color{blue},
  commentstyle=\color{gray},
  stringstyle=\color{red!60!black},
  showstringspaces=false,
  tabsize=2,
  breaklines=true
}

\setbeamercolor{palette primary}{bg=red, fg=white}
\setbeamercolor{palette secondary}{bg=red!95!black, fg=white}
\setbeamercolor{palette tertiary}{bg=red!90!black, fg=white}
\setbeamercolor{frametitle}{bg=red, fg=white}
\setbeamercolor{title}{bg=red, fg=white}
\setbeamercolor{section in toc}{fg=red}

\endinput
